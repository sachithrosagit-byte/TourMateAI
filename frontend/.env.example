# TourMateAI frontend env template. Copy to `frontend/.env` (git-ignored) and fill in.
# Only VITE_-prefixed vars are exposed to the browser bundle — never put secrets here
# that aren't already public (Firebase web config is safe to ship to the client).

# Backend API base URL (Flask). The Axios client prefixes every request with this.
VITE_API_BASE_URL=http://localhost:5000/api

# ===== Google Maps (attraction detail map embed) =====
# A "Maps Embed API"-enabled key. Safe to ship to the browser, but restrict it
# by HTTP referrer in the Google Cloud console. If left blank, attraction pages
# fall back to a static location card with a link out to Google Maps.
VITE_GOOGLE_MAPS_API_KEY=

# ===== Firebase web app config =====
# From Firebase console > Project settings > General > "Your apps" > Web app > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
