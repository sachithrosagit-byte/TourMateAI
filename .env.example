# TourMateAI — environment variable template.
# Copy to `.env` (never commit `.env`) and fill in real values.
# Backend reads these; frontend uses its own VITE_* vars (see frontend/.env.example if added).

# ===== Flask backend =====
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me

# ===== MySQL database =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourmateai
DB_USER=tourmateai_user
DB_PASSWORD=tourmate_ai

# ===== Google Gemini (RAG chatbot) =====
GEMINI_API_KEY=

# ===== Google Maps (routing / location) =====
# Used server-side by the itinerary day-route endpoint (Google **Routes API** —
# enable "Routes API" for this key in the Google Cloud console; the Embed API
# alone is not enough).
GOOGLE_MAPS_API_KEY=
# How long (seconds) the backend reuses a computed day route before
# refetching. Defaults to 21600 (6 h) — routes between fixed attractions
# barely change, and this keeps Routes API free-tier usage minimal.
ROUTE_CACHE_TTL=21600

# ===== OpenWeather (weather context) =====
OPENWEATHER_API_KEY=
# How long (seconds) the backend reuses a fetched weather result before
# refetching. Defaults to 1800 (30 min) — keeps us inside the free-tier limit.
WEATHER_CACHE_TTL=1800

# ===== Firebase Authentication =====
# Path to the service account JSON used by firebase-admin on the backend.
FIREBASE_CREDENTIALS=serviceAccountKey.json

# ===== RAG / AI config =====
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== AI feature routing =====
# True  -> use the mock AI stand-ins in backend/app/services/ai_service.py
# False -> use the teammate's real AI modules (recommender / chatbot / vision)
#          once they are built and the _real_* branches are wired up.
USE_MOCK_AI=True
